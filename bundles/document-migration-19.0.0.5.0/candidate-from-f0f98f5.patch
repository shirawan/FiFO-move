+source "$(dirname "${BASH_SOURCE[0]}")/runtime.sh"
+: "${FIFO_LEGACY_BUNDLE:?Set FIFO_LEGACY_BUNDLE to the published company_financial_cutover-19.0.2.0.1.zip}"
+fifo_start_database
