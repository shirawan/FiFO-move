<odoo>
 <record id="document_form" model="ir.ui.view"><field name="name">company.document.cutover.form</field><field name="model">company.document.cutover</field><field name="arch" type="xml">
  <form string="Move original accounting documents">
   <header><button name="action_execute" type="object" string="Confirm document move" class="btn-primary" invisible="state != 'ready'" confirm="Confirm the reviewed document migration during the agreed maintenance window?"/><button name="action_review" type="object" string="Review my documents" class="btn-primary" invisible="state in ('ready', 'done')"/><button name="action_review" type="object" string="Update review" class="btn-secondary" invisible="state != 'ready'"/><field name="state" widget="statusbar" statusbar_visible="draft,ready,done"/></header>
   <sheet><div class="alert alert-warning" role="status">Candidate for restored-copy testing. Full accounting history is replayed through your cutover date. No second opening entry is added. Cases that need additional history or legal review are reported together.</div>
    <group><field name="name" readonly="state == 'done'"/><field name="source_company_ids" widget="many2many_tags" readonly="state == 'done'"/><field name="target_company_id" readonly="state == 'done'"/><field name="cutover_date" readonly="state == 'done'"/><field name="include_accounting" readonly="state == 'done'"/><field name="same_legal_entity" readonly="state == 'done'"/><field name="existing_data_reviewed" readonly="state == 'done'"/><field name="old_operations_frozen" invisible="True"/></group>
    <group string="Review and result"><field name="report" nolabel="1"/><field name="audit_attachment_id" invisible="not audit_attachment_id"/></group>
    <details invisible="state == 'done'"><summary>Accountant: explicit accounts, taxes and document matches</summary><div class="alert alert-info" role="status">Choose each old-company record and its new-company match by name. Your accountant should review account, journal and tax choices.</div><field name="mapping_ids"><list editable="bottom"><field name="source_record"/><field name="target_record"/></list></field></details>
    <details invisible="state == 'done'"><summary>Accountant: Separate transactions with similar details</summary><p>Only use this when a reported match is a genuinely different transaction. Record the reason for each pair. If it is an earlier copy of the same transaction, leave it unresolved to prevent double counting.</p><field name="overlap_ids"><list editable="bottom"><field name="source_move_id"/><field name="target_move_id"/><field name="separate"/><field name="reason"/></list></field></details>
   </sheet>
  </form>
 </field></record>
 <record id="document_list" model="ir.ui.view"><field name="name">company.document.cutover.list</field><field name="model">company.document.cutover</field><field name="arch" type="xml"><list><field name="name"/><field name="target_company_id"/><field name="cutover_date"/><field name="state"/></list></field></record>
 <record id="document_action" model="ir.actions.act_window"><field name="name">Original document moves (candidate)</field><field name="res_model">company.document.cutover</field><field name="view_mode">list,form</field></record>
 <menuitem id="document_menu" name="Original document moves (candidate)" action="document_action" groups="base.group_system" sequence="99"/>
</odoo>
