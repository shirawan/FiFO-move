<odoo>
 <record id="document_form" model="ir.ui.view"><field name="name">company.document.cutover.form</field><field name="model">company.document.cutover</field><field name="arch" type="xml">
  <form string="Move original accounting documents">
   <header><button name="action_execute" type="object" string="Confirm document move" class="btn-primary" invisible="state != 'ready'" confirm="Confirm the reviewed document migration during the agreed maintenance window?"/><button name="action_review" type="object" string="Review my documents" class="btn-primary" invisible="state in ('ready', 'done')"/><button name="action_review" type="object" string="Update review" class="btn-secondary" invisible="state != 'ready'"/><button name="action_find_setup_matches" type="object" string="Find setup matches" class="btn-secondary" invisible="state == 'done'"/><field name="state" widget="statusbar" statusbar_visible="draft,ready,done"/></header>
   <sheet><div class="alert alert-warning" role="status">Candidate for restored-copy testing. Full accounting history is replayed through your cutover date. No second opening entry is added. Cases that need additional history or legal review are reported together.</div>
    <group>
     <group string="Where to move"><field name="name" readonly="state == 'done'"/><field name="source_company_ids" widget="many2many_tags" readonly="state == 'done'"/><field name="target_company_id" readonly="state == 'done'"/><field name="cutover_date" readonly="state == 'done'"/></group>
     <group string="What to include"><field name="include_accounting" string="Accounting history" readonly="state == 'done'"/><field name="old_operations_frozen" invisible="True"/></group>
    </group>
    <group string="Accountant review" col="1">
     <div class="d-flex align-items-start gap-2"><field name="same_legal_entity" nolabel="1" readonly="state == 'done'"/><label for="same_legal_entity" string="The old and new companies represent the same legal entity and tax registration."/></div>
     <div class="d-flex align-items-start gap-2"><field name="existing_data_reviewed" nolabel="1" readonly="state == 'done'"/><label for="existing_data_reviewed" string="Existing new-company transactions have been checked for earlier transfers."/></div>
    </group>
    <group string="Review and result"><field name="report" nolabel="1"/><field name="audit_attachment_id" invisible="not audit_attachment_id"/></group>
    <details invisible="state == 'done'"><summary>Accountant: step size for larger histories</summary><group><field name="allow_incremental"/><field name="batch_size"/><field name="record_limit"/></group><p>Each confirmation saves one step. Connected invoices, payments, credit notes and bank statements stay together and may exceed the target step size. Review again to continue.</p></details><details invisible="state == 'done'"><summary>Accountant: explicit accounts, taxes and document matches</summary><div class="alert alert-info" role="status">Choose each old-company record and its new-company match by name. Your accountant should review account, journal and tax choices. Select Existing accounting document to reuse an earlier copy after its amounts, dates and payment links are checked.</div><field name="mapping_ids"><list editable="bottom"><field name="source_record"/><field name="target_record"/></list></field></details>
    <details invisible="state == 'done'"><summary>Accountant: Separate transactions with similar details</summary><p>Only use this when a reported match is a genuinely different transaction. Record the reason for each pair. If it is an earlier copy of the same transaction, leave it unresolved to prevent double counting. To reuse an earlier copy, select it as an Existing accounting document match; the mover verifies its native lines and payment links.</p><field name="overlap_ids"><list editable="bottom"><field name="source_move_id"/><field name="target_move_id"/><field name="separate"/><field name="reason"/></list></field></details>
   </sheet>
  </form>
 </field></record>
 <record id="document_list" model="ir.ui.view"><field name="name">company.document.cutover.list</field><field name="model">company.document.cutover</field><field name="arch" type="xml"><list><field name="name"/><field name="target_company_id"/><field name="cutover_date"/><field name="state"/></list></field></record>
 <record id="document_action" model="ir.actions.act_window"><field name="name">Original document moves (candidate)</field><field name="res_model">company.document.cutover</field><field name="view_mode">list,form</field></record>
 <record id="recover_saved_documents" model="ir.actions.server"><field name="name">Recover saved document moves</field><field name="model_id" ref="model_company_document_cutover"/><field name="state">code</field><field name="code">action = model.action_restore_saved_moves()</field></record>
 <menuitem id="recover_document_menu" name="Recover saved document moves" action="recover_saved_documents" groups="base.group_system" sequence="100"/>
 <menuitem id="document_menu" name="Original document moves (candidate)" action="document_action" groups="base.group_system" sequence="99"/>
</odoo>
