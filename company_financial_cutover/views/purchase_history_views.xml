<odoo>
    <record id="purchase_history_list" model="ir.ui.view">
        <field name="name">company.financial.purchase.history.list</field>
        <field name="model">company.financial.purchase.history</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="name" string="Original order"/><field name="vendor_name" string="Vendor"/>
                <field name="original_status_label"/><field name="order_date" string="Original order date"/>
                <field name="company_id" string="New company"/><field name="currency_id"/><field name="amount_total"/>
                <field name="target_order_id" string="Replacement order"/>
            </list>
        </field>
    </record>
    <record id="purchase_history_form" model="ir.ui.view">
        <field name="name">company.financial.purchase.history.form</field>
        <field name="model">company.financial.purchase.history</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0" duplicate="0">
                <header>
                    <button name="action_prepare_draft" type="object" string="Prepare replacement draft" class="oe_highlight"
                        groups="account.group_account_manager"
                        invisible="not draft_eligible or target_order_id"
                        confirm="Prepare one unconfirmed draft in the new company? Review its vendor, products, prices and taxes before confirming. The original order must already be cancelled so it cannot be received or billed twice."/>
                    <button name="action_prepare_draft" type="object" string="View replacement order" class="oe_highlight"
                        groups="account.group_account_manager" invisible="not target_order_id"/>
                    <field name="draft_eligible" invisible="True"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status"><strong>Saved purchase history</strong>
                        <p class="mb-0">This copy shows the order as it was when approved for the move. Receipts, payments and vendor bills were not recreated. Remaining quantities below are from that time.</p></div>
                    <h1><field name="name"/></h1>
                    <group>
                        <group string="Original order">
                            <field name="vendor_name" string="Vendor"/><field name="original_status_label"/>
                            <field name="order_date" string="Order date"/><field name="source_company_name"/>
                        </group>
                        <group string="New company">
                            <field name="company_id" string="New company" options="{'no_open': True}"/>
                            <field name="currency_id" options="{'no_open': True}"/>
                            <field name="amount_total" string="Order total"/>
                            <field name="target_order_id" string="Replacement order" invisible="not target_order_id"/>
                        </group>
                    </group>
                    <div class="alert alert-secondary" role="status"><p class="mb-1"><strong>What happens next</strong></p>
                        <field name="draft_guidance" nolabel="1"/></div>
                    <separator string="Products and remaining quantities"/>
                    <field name="details_html" nolabel="1"/>
                    <field name="original_note" invisible="not original_note"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="purchase_history_action" model="ir.actions.act_window">
        <field name="name">Migrated purchase history</field>
        <field name="res_model">company.financial.purchase.history</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="purchase_history_menu" name="Migrated purchase history" parent="purchase.menu_purchase_root"
        action="purchase_history_action" groups="purchase.group_purchase_user" sequence="90"/>
</odoo>
