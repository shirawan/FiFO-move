<odoo>
    <record id="warehouse_location_choice_company_rule" model="ir.rule">
        <field name="name">Warehouse location choices require both companies</field>
        <field name="model_id" ref="model_company_stock_warehouse_location_choice"/>
        <field name="domain_force">[('cutover_id.source_company_id', 'in', company_ids), ('cutover_id.target_company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
